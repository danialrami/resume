# ====== PDF V2 Pipeline Configuration ======
# Copy this file to .env and fill in your values

# ====== PATHS ======
DATA_PATH=data/resume.yaml
DB_PATH=db/chroma
OUTPUT_PATH=dist/pdf/tailored_resume.pdf
TEMPLATE_PATH=templates/latex/resume_tailored.tex

# ====== LLM CONFIG (litellm) ======
# Your litellm instance
LLM_BASE_URL=http://100.89.168.11:6280/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# ====== EMBEDDINGS ======
# Embedding model (via litellm compatible API)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ====== PIPELINE SETTINGS ======
MAX_ITERATIONS=5
MAX_BULLETS=12
MAX_BULLET_CHARS=150

# ====== LATEX ======
LATEX_COMPILER=xelatex