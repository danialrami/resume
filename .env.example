# ====== PDF V2 Pipeline Configuration ======
# Copy this file to .env and fill in your values

# ====== PATHS ======
DATA_PATH=data/resume.yaml
DB_PATH=db/chroma
OUTPUT_PATH=dist/pdf/v2
TEMPLATE_PATH=templates/latex/resume_tailored.tex
REFERENCE_PDF=dist/pdf/resume.pdf

# ====== LLM CONFIG (litellm) ======
LLM_BASE_URL=http://100.89.168.11:6280/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=vision-model

# ====== EMBEDDINGS ======
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ====== PIPELINE SETTINGS ======
MAX_ITERATIONS=5
MAX_BULLETS=12
MAX_BULLET_CHARS=150

# ====== VALIDATION ======
VALIDATION_ENABLED=true
VALIDATION_VISION_ENABLED=false  # Set true after adding vision model credentials
VALIDATION_REFERENCE_PDF=dist/pdf/resume.pdf

# ====== PROMPTS ======
PROMPTS_DIR=scripts/prompts

# ====== LATEX ======
LATEX_COMPILER=xelatex