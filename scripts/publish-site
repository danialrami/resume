#!/usr/bin/env bash
# Publish the built artifact (dist/html/) to the agnostic `site` branch using ONLY
# git. No hosting-provider APIs, no third-party actions — the host (Cloudflare Pages
# git-integration, or a Hostinger webhook) subscribes to the `site` branch and
# deploys whatever lands there. Swapping hosts never touches this script.
#
# Env:
#   SITE_BRANCH   target branch (default: site)
#   REMOTE        push target (default: origin's URL). In CI, pass an authenticated
#                 URL, e.g. https://x-access-token:${GITHUB_TOKEN}@github.com/${REPO}.git
#   GIT_SHA       source commit (default: current HEAD)
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

SITE_BRANCH="${SITE_BRANCH:-site}"
REMOTE="${REMOTE:-$(git config --get remote.origin.url)}"
: "${GIT_SHA:=$(git rev-parse HEAD 2>/dev/null || echo unknown)}"

[ -s dist/html/index.html ] || { echo "publish-site: dist/html/index.html missing — run scripts/build first"; exit 1; }

# Build the branch content in an isolated worktree so we never disturb the checkout.
tmp="$(mktemp -d)"
cleanup() { rm -rf "$tmp"; }
trap cleanup EXIT

cp -R dist/html/. "$tmp"/
# .nojekyll keeps static hosts from mangling underscore-prefixed dirs.
touch "$tmp/.nojekyll"

cd "$tmp"
git init -q
git checkout -q -b "$SITE_BRANCH"
git add -A
git -c user.name="${GIT_AUTHOR_NAME:-site-release}" \
    -c user.email="${GIT_AUTHOR_EMAIL:-site-release@users.noreply.github.com}" \
    commit -qm "site: build from ${GIT_SHA}"

# Force-push: the `site` branch is disposable build output, never source history.
git push -f "$REMOTE" "$SITE_BRANCH"
echo "publish-site: pushed dist/html/ -> ${SITE_BRANCH}"
